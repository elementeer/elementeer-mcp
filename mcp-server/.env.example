ELEMENTEER_CONFIG_PATH=~/.elementeer/config.json
ELEMENTEER_LOG_LEVEL=info

# Bridge for rendering/screenshots (ELM-RENDER-002)
# Base URL of the elementeer-bridge API, e.g. http://localhost:3201
ELEMENTEER_BRIDGE_URL=http://localhost:3201
# API key for the bridge — create via POST /api/auth/keys on the bridge
ELEMENTEER_BRIDGE_API_KEY=
